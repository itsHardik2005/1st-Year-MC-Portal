# ==============================================================================
# Telegram Bot & Supabase Environment Template (.env.example)
# Copy this file to .env or .env.local and populate with your real secrets.
# NEVER commit .env or .env.local with production credentials to Git.
# ==============================================================================

# 1. Telegram Bot Token from @BotFather
# Format: <digits>:<alphanumeric_string>
# Example: "8631409156:AAHIXJjcoTV9csYoXwu_Px2XnmNIZIvv60g"
TELEGRAM_BOT_TOKEN=""

# 2. Supabase Project REST URL
# Format: Must start with https://
# Example: "https://xyzcompany.supabase.co"
SUPABASE_URL="https://your-project-ref.supabase.co"

# 3. Supabase Anonymous / Public Key
# Found in Supabase Dashboard > Project Settings > API > Project API keys (anon / public)
SUPABASE_ANON_KEY=""

# 4. Primary Administrator Telegram Numeric ID
# Numeric ID (integer or numeric string) from @userinfobot or Telegram API
# Example: "123456789"
ADMIN_TELEGRAM_ID=""

# ------------------------------------------------------------------------------
# Optional Portal Client Compatibility (Next.js frontend)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
NEXT_PUBLIC_TELEGRAM_BOT_URL="https://t.me/firstyearhelpbot"
